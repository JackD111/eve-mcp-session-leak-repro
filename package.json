{
  "name": "eve-mcp-session-leak-repro",
  "version": "0.0.0",
  "type": "module",
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "build": "eve build",
    "deploy": "eve deploy",
    "dev": "eve dev",
    "eval": "eve eval",
    "start": "eve start",
    "typecheck": "tsc",
    "mcp": "supergateway --stdio \"node mcp-stub.mjs\" --outputTransport streamableHttp --port 8000 --streamableHttpPath /mcp --stateful --sessionTimeout 60000",
    "sessions": "node sessions.mjs",
    "proxy": "node latency-proxy.mjs"
  },
  "dependencies": {
    "@vercel/connect": "2.2.0",
    "ai": "^7.0.105",
    "eve": "^0.71.2",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "24.x",
    "supergateway": "3.4.3",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": "24.x"
  }
}
